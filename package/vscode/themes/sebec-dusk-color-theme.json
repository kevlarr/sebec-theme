    "semanticTokenColors": {
        "*.typeHint": {
            "foreground": "#4f97ba",
            "fontStyle": "italic"
        },
        "decorator": {
            "foreground": "#4f97ba",
            "fontStyle": "italic"
        },
        "function.declaration": {
            "foreground": "#4f97ba",
            "fontStyle": "bold"
        },
        "method.declaration": {
            "foreground": "#4f97ba",
            "fontStyle": "bold"
        },
        "class.declaration": {
            "foreground": "#4f97ba",
            "fontStyle": "bold"
        },
        "enum.declaration": {
            "foreground": "#4f97ba",
            "fontStyle": "bold"
        },
        "interface.declaration": {
            "foreground": "#4f97ba",
            "fontStyle": "bold"
        },
        "struct.declaration": {
            "foreground": "#4f97ba",
            "fontStyle": "bold"
        },
        "parameter": "#bcc3d2",
        "function": "#4f97ba",
        "method": "#4f97ba",
        "variable.builtin": "#4f97ba",
        "type.defaultLibrary": "#4f97ba",
        "class.defaultLibrary": "#4f97ba",
        "function.defaultLibrary": "#4f97ba",
        "string": "#8d6c9d"
    },
    "tokenColors": [
        {
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#bcc3d2"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "punctuation.parenthesis",
                "punctuation.definition.arguments",
                "punctuation.separator",
                "punctuation.section.class.begin",
                "punctuation.section.function.begin",
                "storage.type",
                "storage.type.class",
                "storage.type.function",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#546cb6"
            }
        },
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#51744e",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "constant.numeric",
                "constant.language"
            ],
            "settings": {
                "foreground": "#8d6c9d"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.language",
                "support.type.primitive"
            ],
            "settings": {
                "foreground": "#4f97ba"
            }
        },
        {
            "scope": [
                "entity.name.function.decorator"
            ],
            "settings": {
                "foreground": "#4f97ba",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "entity.name.tag.html",
                "entity.name.tag.svelte"
            ],
            "settings": {
                "foreground": "#546cb6"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.svelte"
            ],
            "settings": {
                "foreground": "#4f97ba",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.begin.svelte",
                "punctuation.definition.tag.end.html",
                "punctuation.definition.tag.end.svelte"
            ],
            "settings": {
                "foreground": "#546cb6"
            }
        },
        {
            "scope": [
                "support.type.property-name.json",
                "entity.name.tag.yaml"
            ],
            "settings": {
                "foreground": "#4f97ba",
                "fontStyle": "italic"
            }
        }
    ]
}