    "semanticTokenColors": {
        "*.typeHint": {
            "foreground": "#4e89a6",
            "fontStyle": "italic"
        },
        "decorator": {
            "foreground": "#4e89a6",
            "fontStyle": "italic"
        },
        "variable.builtin": "#4e89a6",
        "type.defaultLibrary": "#4e89a6",
        "class.defaultLibrary": "#4e89a6",
        "function.defaultLibrary": "#4e89a6",
        "string": "#a58bb1"
    },
    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#4d6e49",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.logical",
                "storage.type",
                "storage.type.class",
                "storage.type.function",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#4972ab"
            }
        },
        {
            "scope": [
                "string",
                "constant.numeric",
                "constant.language"
            ],
            "settings": {
                "foreground": "#a58bb1"
            }
        },
        {
            "scope": [
                "variable.language",
                "support.function.builtin",
                "support.type.builtin",
                "support.type.primitive"
            ],
            "settings": {
                "foreground": "#4e89a6"
            }
        },
        {
            "scope": [
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "punctuation.parenthesis",
                "punctuation.definition.arguments",
                "punctuation.separator",
                "punctuation.section.class.begin",
                "punctuation.section.function.begin"
            ],
            "settings": {
                "foreground": "#404859"
            }
        },
        {
            "scope": [
                "entity.name.function.decorator"
            ],
            "settings": {
                "foreground": "#4e89a6",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "entity.name.tag.html",
                "entity.name.tag.svelte"
            ],
            "settings": {
                "foreground": "#4972ab"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.svelte"
            ],
            "settings": {
                "foreground": "#4e89a6",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.begin.svelte",
                "punctuation.definition.tag.end.html",
                "punctuation.definition.tag.end.svelte"
            ],
            "settings": {
                "foreground": "#404859"
            }
        },
        {
            "scope": [
                "support.type.property-name.json",
                "entity.name.tag.yaml"
            ],
            "settings": {
                "foreground": "#4e89a6",
                "fontStyle": "italic"
            }
        }
    ]
}