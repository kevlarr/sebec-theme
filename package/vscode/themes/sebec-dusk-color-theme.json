    "tokenColors": [
        {
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#bcc7d2"
            }
        },
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "punctuation.parenthesis",
                "punctuation.definition.arguments",
                "punctuation.separator",
                "punctuation.section.class.begin",
                "punctuation.section.function.begin",
                "storage.type",
                "storage.type.class",
                "storage.type.function",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#718598"
            }
        },
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#2f669d",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "constant.numeric",
                "constant.language"
            ],
            "settings": {
                "foreground": "#59a673"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "support.type"
            ],
            "settings": {
                "foreground": "#867cb6"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "entity.name.class",
                "support.function",
                "support.class",
                "support.type.primitive",
                "variable.language"
            ],
            "settings": {
                "foreground": "#3badc4"
            }
        },
        {
            "scope": [
                "entity.name.function.decorator",
                "punctuation.decorator",
                "punctuation.definition.decorator"
            ],
            "settings": {
                "foreground": "#867cb6",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "entity.name.tag.html",
                "entity.name.tag.svelte"
            ],
            "settings": {
                "foreground": "#3badc4"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.svelte",
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.begin.svelte",
                "punctuation.definition.tag.end.html",
                "punctuation.definition.tag.end.svelte"
            ],
            "settings": {
                "foreground": "#718598"
            }
        },
        {
            "scope": [
                "support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#718598"
            }
        },
        {
            "scope": [
                "entity.name.tag.yaml"
            ],
            "settings": {
                "foreground": "#bcc7d2"
            }
        },
        {
            "scope": [
                "variable.other.anchor.yaml"
            ],
            "settings": {
                "foreground": "#62bed0",
                "fontStyle": "bold"
            }
        },
        {
            "scope": [
                "variable.other.alias.yaml"
            ],
            "settings": {
                "foreground": "#3badc4"
            }
        }
    ]
