    "semanticTokenColors": {
        "*.typeHint": {
            "foreground": "#4f97ba",
            "fontStyle": "italic"
        },
        "decorator": {
            "foreground": "#4f97ba",
            "fontStyle": "italic"
        },
        "function": "#4f97ba",
        "method": "#4f97ba",
        "variable.builtin": "#4f97ba",
        "type.defaultLibrary": "#4f97ba",
        "class.defaultLibrary": "#4f97ba",
        "function.defaultLibrary": "#4f97ba",
        "string": {
            "foreground": "#8d6c9d",
            "fontStyle": "italic"
        }
    },
    "tokenColors": [
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.logical",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.comparison",
                "punctuation.parenthesis",
                "punctuation.definition.arguments",
                "punctuation.separator",
                "punctuation.section.class.begin",
                "punctuation.section.function.begin",
                "storage.type",
                "storage.type.class",
                "storage.type.function",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#7e91c8"
            }
        },
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#94b691",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string",
                "constant.numeric",
                "constant.language"
            ],
            "settings": {
                "foreground": "#8d6c9d",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "variable.language",
                "support.type.primitive"
            ],
            "settings": {
                "foreground": "#4f97ba"
            }
        },
        {
            "scope": [
                "entity.name.function.decorator"
            ],
            "settings": {
                "foreground": "#4f97ba",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "entity.name.tag.html",
                "entity.name.tag.svelte"
            ],
            "settings": {
                "foreground": "#7e91c8"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name.html",
                "entity.other.attribute-name.svelte"
            ],
            "settings": {
                "foreground": "#4f97ba",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "punctuation.definition.tag.begin.html",
                "punctuation.definition.tag.begin.svelte",
                "punctuation.definition.tag.end.html",
                "punctuation.definition.tag.end.svelte"
            ],
            "settings": {
                "foreground": "#7e91c8"
            }
        },
        {
            "scope": [
                "support.type.property-name.json",
                "entity.name.tag.yaml"
            ],
            "settings": {
                "foreground": "#4f97ba",
                "fontStyle": "italic"
            }
        }
    ]
}