    "tokenColors": [
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#89b3dc",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "string.quoted.docstring"
            ],
            "settings": {
                "foreground": "#2f669d",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "entity.name.class",
                "entity.name.function",
                "entity.name.type",
                "support.class",
                "support.function",
                "constant.character.escape"
            ],
            "settings": {
                "foreground": "#2f8b9d"
            }
        },
        {
            "scope": [
                "string",
                "constant.numeric",
                "constant.language"
            ],
            "settings": {
                "foreground": "#478570"
            }
        },
        {
            "scope": [
                "entity.name.function.decorator",
                "punctuation.decorator",
                "punctuation.definition.decorator"
            ],
            "settings": {
                "foreground": "#8b95c6",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "keyword",
                "punctuation",
                "storage"
            ],
            "settings": {
                "foreground": "#8394a5"
            }
        },
        {
            "scope": [
                "entity.name.tag",
                "entity.name.tag",
                "punctuation.definition.variable.svelte"
            ],
            "settings": {
                "foreground": "#2f8b9d"
